{
  "name": "flickr-deduper",
  "version": "2.0.0",
  "private": true,
  "description": "Audit Flickr albums for same-timestamp photos, reorder albums, and back up originals.",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "oauth": "node src/oauth.js",
    "cli": "node src/cli.js",
    "schedule": "node src/scheduler.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "node scripts/check-syntax.js",
    "check": "npm run lint && npm test"
  },
  "license": "MIT"
}
